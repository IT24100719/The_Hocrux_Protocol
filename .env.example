# Copy to .env and fill in. .env is gitignored.
LAB_IP=127.0.0.1
DB_PASSWORD=change_me_strong_password
CTFD_SECRET_KEY=change_me_long_random_hex

# ---- Admin + CTF identity (used by tools/seed_ctfd.py to run the setup wizard
# on a fresh DB and to log in afterwards). On a full reset the admin is recreated
# from these values.
CTF_NAME=The Horcrux Protocol
CTFD_ADMIN_NAME=admin
CTFD_ADMIN_EMAIL=admin@lab.test
CTFD_ADMIN_PASSWORD=change_me_admin_password
# CTFD_URL=http://127.0.0.1:8000
# Welcome points granted to each new player (0 disables).
HORCRUX_START_POINTS=100
# These are injected into the HX-02 container. Copy the real values from
# integration.yml into your own .env (gitignored) — do NOT put real flags here.
HX02_FLAG=HORCRUX{set_from_integration_yml_hx02}
HX02_CIPHERTEXT=
HX02_TARGET_USER=triddle
